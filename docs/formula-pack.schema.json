{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Math Input Formula Pack v1",
  "$comment": "ID uniqueness, slot correspondence, TeX safety, expanded nesting and MathLive parsing require the semantic validators described in FORMULA_PACK_SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "author", "description", "snippets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "version": {"type": "string", "pattern": "^[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}$"},
    "author": {"type": "string", "maxLength": 120},
    "description": {"type": "string", "maxLength": 1000},
    "snippets": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/snippet"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "command": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,39}$"},
    "parameterId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "description", "defaultValue"],
      "properties": {
        "id": {"$ref": "#/$defs/parameterId"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string", "maxLength": 500},
        "defaultValue": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "snippet": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "command", "aliases", "name", "description", "latex", "parameters"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "command": {"$ref": "#/$defs/command"},
        "aliases": {"type": "array", "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/command"}},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string", "maxLength": 1000},
        "latex": {"type": "string", "minLength": 1, "maxLength": 8192},
        "parameters": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/parameter"}},
        "wrapTarget": {"$ref": "#/$defs/parameterId"},
        "preferSelection": {"type": "boolean", "default": true}
      }
    }
  }
}
