{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Math Input",
  "version": "0.2.0",
  "identifier": "local.mathinput.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Math Input",
      "width": 420,
      "height": 224,
      "minWidth": 320,
      "minHeight": 188,
      "center": true,
      "decorations": false,
      "alwaysOnTop": true,
      "resizable": true,
      "shadow": true,
      "backgroundColor": "#12151f"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
